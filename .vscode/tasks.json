{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile CTI Sentinel",
      "type": "shell",
      "command": "javac",
      "args": ["-encoding", "UTF-8", "-d", "out", "src/CtiAdvancedApp.java"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$javac"
    },
    {
      "label": "Run CTI Sentinel",
      "type": "shell",
      "command": "java",
      "args": ["-cp", "out", "CtiAdvancedApp"],
      "dependsOn": "Compile CTI Sentinel",
      "problemMatcher": []
    }
  ]
}
